# Copy these lines into .streamlit/secrets.toml on your own computer,
# or into Streamlit Community Cloud's Settings > Secrets.
# Keep your real key private. You do not need a key for Offline demo.

# OPENAI_API_KEY = "paste-your-key-here"
# ANTHROPIC_API_KEY = "paste-your-key-here"
# GEMINI_API_KEY = "paste-your-key-here"
